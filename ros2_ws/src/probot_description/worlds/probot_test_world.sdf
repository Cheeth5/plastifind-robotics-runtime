<?xml version="1.0"?>
<sdf version="1.9">
  <world name="probot_test_world">
    <physics name="probot_physics" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <gravity>0 0 -9.81</gravity>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <background>0.72 0.82 0.90 1</background>
      <shadows>true</shadows>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.2 -0.8</direction>
    </light>
    <model name="ground">
      <static>true</static>
      <link name="ground_link">
        <collision name="ground_collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="ground_visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.75 0.70 0.58 1</ambient><diffuse>0.75 0.70 0.58 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Bounded 10 x 8 metre test arena for repeatable SLAM runs. -->
    <model name="north_wall"><static>true</static><pose>0 4 0.5 0 0 0</pose><link name="wall">
      <collision name="collision"><geometry><box><size>10 0.15 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>10 0.15 1</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
    </link></model>
    <model name="south_wall"><static>true</static><pose>0 -4 0.5 0 0 0</pose><link name="wall">
      <collision name="collision"><geometry><box><size>10 0.15 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>10 0.15 1</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
    </link></model>
    <model name="east_wall"><static>true</static><pose>5 0 0.5 0 0 0</pose><link name="wall">
      <collision name="collision"><geometry><box><size>0.15 8 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.15 8 1</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
    </link></model>
    <model name="west_wall"><static>true</static><pose>-5 0 0.5 0 0 0</pose><link name="wall">
      <collision name="collision"><geometry><box><size>0.15 8 1</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.15 8 1</size></box></geometry><material><ambient>0.55 0.58 0.62 1</ambient><diffuse>0.55 0.58 0.62 1</diffuse></material></visual>
    </link></model>

    <!-- Irregular obstacles for LiDAR scans, SLAM and Nav2 costmaps. -->
    <model name="central_obstacle"><static>true</static><pose>1.2 1.0 0.35 0 0 0</pose><link name="obstacle">
      <collision name="collision"><geometry><box><size>0.8 0.7 0.7</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.8 0.7 0.7</size></box></geometry><material><ambient>0.35 0.38 0.42 1</ambient><diffuse>0.35 0.38 0.42 1</diffuse></material></visual>
    </link></model>
    <model name="side_obstacle"><static>true</static><pose>-1.6 -1.5 0.25 0 0 0.35</pose><link name="obstacle">
      <collision name="collision"><geometry><box><size>1.0 0.45 0.5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>1.0 0.45 0.5</size></box></geometry><material><ambient>0.42 0.32 0.22 1</ambient><diffuse>0.42 0.32 0.22 1</diffuse></material></visual>
    </link></model>

    <!-- Bottle props: simplified geometry for camera framing and future CV datasets. -->
    <model name="plastic_bottle_01"><static>true</static><pose>2.2 0.35 0.055 0 1.5708 0.25</pose><link name="bottle">
      <collision name="collision"><geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry></collision>
      <visual name="body"><geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry><material><ambient>0.25 0.65 0.9 0.8</ambient><diffuse>0.25 0.65 0.9 0.8</diffuse></material></visual>
    </link></model>
    <model name="plastic_bottle_02"><static>true</static><pose>3.1 -1.0 0.055 0 1.5708 -0.5</pose><link name="bottle">
      <collision name="collision"><geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry></collision>
      <visual name="body"><geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry><material><ambient>0.25 0.65 0.9 0.8</ambient><diffuse>0.25 0.65 0.9 0.8</diffuse></material></visual>
    </link></model>
    <model name="plastic_bottle_03"><static>true</static><pose>0.6 -2.4 0.055 0 1.5708 0.9</pose><link name="bottle">
      <collision name="collision"><geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry></collision>
      <visual name="body"><geometry><cylinder><radius>0.035</radius><length>0.22</length></cylinder></geometry><material><ambient>0.25 0.65 0.9 0.8</ambient><diffuse>0.25 0.65 0.9 0.8</diffuse></material></visual>
    </link></model>

    <!-- Static generic human proxy. It is a CV target, not an identity model. -->
    <model name="human_littering_target"><static>true</static><pose>3.2 0.9 0 0 0 -0.35</pose>
      <link name="torso"><pose>0 0 1.05 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.42 0.25 0.65</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.42 0.25 0.65</size></box></geometry><material><ambient>0.12 0.22 0.32 1</ambient><diffuse>0.12 0.22 0.32 1</diffuse></material></visual>
      </link>
      <link name="head"><pose>0 0 1.52 0 0 0</pose>
        <collision name="collision"><geometry><sphere><radius>0.13</radius></sphere></geometry></collision>
        <visual name="visual"><geometry><sphere><radius>0.13</radius></sphere></geometry><material><ambient>0.72 0.52 0.38 1</ambient><diffuse>0.72 0.52 0.38 1</diffuse></material></visual>
      </link>
      <link name="left_leg"><pose>0 0.11 0.38 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 0.14 0.72</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.14 0.72</size></box></geometry><material><ambient>0.16 0.18 0.2 1</ambient><diffuse>0.16 0.18 0.2 1</diffuse></material></visual>
      </link>
      <link name="right_leg"><pose>0 -0.11 0.38 0 0 0</pose>
        <collision name="collision"><geometry><box><size>0.15 0.14 0.72</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.15 0.14 0.72</size></box></geometry><material><ambient>0.16 0.18 0.2 1</ambient><diffuse>0.16 0.18 0.2 1</diffuse></material></visual>
      </link>
      <link name="left_arm"><pose>0.02 0.25 1.12 0.7 0 0</pose>
        <collision name="collision"><geometry><box><size>0.13 0.48 0.13</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.13 0.48 0.13</size></box></geometry><material><ambient>0.12 0.22 0.32 1</ambient><diffuse>0.12 0.22 0.32 1</diffuse></material></visual>
      </link>
      <link name="right_arm"><pose>0.16 -0.25 0.95 0.2 0 0</pose>
        <collision name="collision"><geometry><box><size>0.13 0.48 0.13</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.13 0.48 0.13</size></box></geometry><material><ambient>0.12 0.22 0.32 1</ambient><diffuse>0.12 0.22 0.32 1</diffuse></material></visual>
      </link>
    </model>
  </world>
</sdf>

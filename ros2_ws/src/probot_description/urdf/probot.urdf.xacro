<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="probot">
  <!-- Provisional geometry: update from verified measurements/CAD later. Units are metres. -->
  <xacro:property name="body_length" value="0.72"/>
  <xacro:property name="body_width" value="0.50"/>
  <xacro:property name="body_height" value="0.18"/>
  <xacro:property name="wheel_radius" value="0.115"/>
  <xacro:property name="wheel_width" value="0.05"/>
  <xacro:property name="wheel_x" value="0.23"/>
  <xacro:property name="wheel_y" value="0.205"/>
  <xacro:property name="body_mass" value="18.0"/>
  <xacro:property name="wheel_mass" value="1.2"/>

  <material name="chassis_dark"><color rgba="0.12 0.18 0.22 1"/></material>
  <material name="wheel_black"><color rgba="0.035 0.04 0.045 1"/></material>
  <material name="sensor_blue"><color rgba="0.0 0.65 0.85 1"/></material>

  <link name="base_footprint"/>
  <link name="base_link">
    <visual><origin xyz="0 0 0.20"/><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry><material name="chassis_dark"/></visual>
    <collision><origin xyz="0 0 0.20"/><geometry><box size="${body_length} ${body_width} ${body_height}"/></geometry></collision>
    <inertial><origin xyz="0 0 0.20"/><mass value="${body_mass}"/><inertia ixx="0.50" ixy="0" ixz="0" iyy="0.90" iyz="0" izz="1.10"/></inertial>
  </link>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/><child link="base_link"/><origin xyz="0 0 0.0"/>
  </joint>

  <xacro:macro name="wheel" params="name x y">
    <link name="${name}_link">
      <visual><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry><material name="wheel_black"/></visual>
      <collision><origin rpy="1.5707963 0 0"/><geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry></collision>
      <inertial><mass value="${wheel_mass}"/><inertia ixx="0.006" ixy="0" ixz="0" iyy="0.006" iyz="0" izz="0.010"/></inertial>
    </link>
    <joint name="${name}_joint" type="continuous">
      <parent link="base_link"/><child link="${name}_link"/>
      <origin xyz="${x} ${y} 0.115" rpy="0 0 0"/><axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left_wheel" x="${wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="rear_left_wheel" x="-${wheel_x}" y="${wheel_y}"/>
  <xacro:wheel name="front_right_wheel" x="${wheel_x}" y="-${wheel_y}"/>
  <xacro:wheel name="rear_right_wheel" x="-${wheel_x}" y="-${wheel_y}"/>

  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.045" length="0.055"/></geometry><material name="sensor_blue"/></visual>
    <collision><geometry><cylinder radius="0.045" length="0.055"/></geometry></collision>
    <inertial><mass value="0.25"/><inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/></inertial>
  </link>
  <joint name="lidar_joint" type="fixed"><parent link="base_link"/><child link="lidar_link"/><origin xyz="0.20 0 0.34"/></joint>

  <link name="camera_link">
    <visual><geometry><box size="0.06 0.04 0.035"/></geometry><material name="sensor_blue"/></visual>
    <inertial><mass value="0.10"/><inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/></inertial>
  </link>
  <joint name="camera_joint" type="fixed"><parent link="base_link"/><child link="camera_link"/><origin xyz="0.31 0 0.27" rpy="0 0 0"/></joint>
</robot>
